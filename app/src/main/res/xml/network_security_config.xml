<?xml version="1.0" encoding="utf-8"?>
<!-- Trust user-installed CAs too, so a Mealie server behind a private/homelab CA loads in the
     WebView. Since Android 7 apps only trust system CAs unless they opt in here. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
